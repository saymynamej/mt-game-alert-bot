<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    <changeSet id="create-notify-table" author="saymyname">
        <createTable tableName="events">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="true"/>
            </column>
            <column name="chat_id" type="BIGINT">
                <constraints primaryKey="true" nullable="true"/>
            </column>
            <column name="poll_message" type="varchar">
                <constraints nullable="false"/>
            </column>
            <column name="notify_date" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="force_send" type="boolean">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>